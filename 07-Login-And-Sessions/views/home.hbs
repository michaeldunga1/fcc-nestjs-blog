<h1>{{title}}</h1>
<p class="lead">{{lead}}</p>
{{#if posts.length}}
  {{#each posts}}
    <article class="post-card">
      <h2 class="h4">{{#if ../detail}}<a href="/posts/{{id}}">{{title}}</a>{{else}}{{title}}{{/if}}</h2>
      <p class="text-muted mb-1">by {{authorName}}</p>
      <p>{{excerpt}}</p>
    </article>
  {{/each}}
{{else}}
  <p class="text-muted">No stories yet.</p>
{{/if}}
{{#if pagination}}
  <nav class="d-flex gap-2 align-items-center">
    {{#if pagination.prev}}<a class="btn btn-sm btn-outline-secondary" href="/?page={{pagination.prev}}{{#if q}}&q={{q}}{{/if}}">Prev</a>{{/if}}
    <span>Page {{pagination.page}} / {{pagination.pages}}</span>
    {{#if pagination.next}}<a class="btn btn-sm btn-outline-secondary" href="/?page={{pagination.next}}{{#if q}}&q={{q}}{{/if}}">Next</a>{{/if}}
  </nav>
{{/if}}
