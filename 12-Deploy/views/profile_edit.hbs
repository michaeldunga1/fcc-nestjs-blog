<h1>Edit profile</h1>
<form method="post" action="/profile/edit" enctype="multipart/form-data" class="col-md-6">
  <div class="mb-3"><label class="form-label">Display name</label><input class="form-control" name="displayName" value="{{profile.displayName}}" required /></div>
  <div class="mb-3"><label class="form-label">Bio</label><textarea class="form-control" name="bio" rows="4">{{profile.bio}}</textarea></div>
  <div class="mb-3"><label class="form-label">Avatar</label><input class="form-control" type="file" name="image" accept="image/jpeg,image/png,image/webp" /></div>
  <button class="btn btn-primary" type="submit">Save</button>
</form>
