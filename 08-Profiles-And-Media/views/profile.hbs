<h1>{{profile.displayName}}</h1>
{{#if profile.imagePath}}<img class="avatar" src="{{profile.imagePath}}" alt="" />{{/if}}
<p>{{#if profile.bio}}{{profile.bio}}{{else}}No bio yet.{{/if}}</p>
{{#if isSelf}}<p><a href="/profile/edit">Edit profile</a></p>{{/if}}
<h2>Posts</h2>
{{#each posts}}<p><a href="/posts/{{id}}">{{title}}</a></p>{{else}}<p class="text-muted">No posts yet.</p>{{/each}}
