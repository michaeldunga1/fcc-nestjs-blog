<div class="d-flex gap-3 align-items-start">
  {{#if profile.imagePath}}<img class="avatar" src="{{profile.imagePath}}" alt="" />{{/if}}
  <div>
    <h1>{{profile.displayName}}</h1>
    <p class="text-muted">@{{profile.username}}</p>
    <p>{{profile.bio}}</p>
    {{#if isSelf}}<a class="btn btn-sm btn-outline-primary" href="/profile/edit">Edit profile</a>{{/if}}
  </div>
</div>
<hr />
{{#each posts}}
  <article class="post-card"><h2 class="h5"><a href="/posts/{{id}}">{{title}}</a></h2></article>
{{/each}}
