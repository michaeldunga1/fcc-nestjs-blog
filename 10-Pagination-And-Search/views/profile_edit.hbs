<h1>Edit profile</h1>
<form method="post" enctype="multipart/form-data">
  <div class="mb-3"><label class="form-label">Display name</label><input class="form-control" name="displayName" value="{{profile.displayName}}" required /></div>
  <div class="mb-3"><label class="form-label">Bio</label><textarea class="form-control" name="bio">{{profile.bio}}</textarea></div>
  <div class="mb-3"><label class="form-label">Avatar</label><input class="form-control" type="file" name="image" accept="image/*" /></div>
  <button class="btn btn-primary">Save</button>
</form>
