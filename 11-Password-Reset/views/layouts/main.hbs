<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}} — Circuit Daily</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/static/site.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Circuit Daily</a>
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>

        {{#if user}}
          <li class="nav-item"><a class="nav-link" href="/profile">Profile</a></li>
          {{#if canCreate}}<li class="nav-item"><a class="nav-link" href="/posts/new">New post</a></li>{{/if}}
          <li class="nav-item"><a class="nav-link" href="/logout">Log out</a></li>
        {{else}}
          <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Log in</a></li>
        {{/if}}

      </ul>

    <form class="d-flex ms-3" method="get" action="/">
      <input class="form-control form-control-sm me-2" type="search" name="q" value="{{q}}" placeholder="Search" />
      <button class="btn btn-sm btn-outline-light" type="submit">Search</button>
    </form>

    </div>
  </nav>
  <main class="container mb-5">
    {{#if flash}}
      <div class="alert alert-info">{{flash}}</div>
    {{/if}}
    {{body}}
  </main>
  <footer class="container"><small class="text-muted">Circuit Daily — Free Computer Courses</small></footer>
</body>
</html>
