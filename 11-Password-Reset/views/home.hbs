<h1>{{heading}}</h1>
<p>{{lead}}</p>
{{#if qDefined}}
<form method="get" class="mb-3"><input class="form-control" name="q" value="{{q}}" placeholder="Search" /><button class="btn btn-primary mt-2">Search</button></form>
{{/if}}
{{#each posts}}
  <article class="mb-3">
    <h2>{{#if id}}<a href="/posts/{{id}}">{{title}}</a>{{else}}{{title}}{{/if}}</h2>
    <p class="text-muted">by {{authorName}}</p>
    <p>{{excerpt}}</p>
  </article>
{{else}}
  <p>No stories yet.</p>
{{/each}}
{{#if pagination}}
  <nav>
    {{#if pagination.prev}}<a href="/?page={{pagination.prev}}{{#if ../q}}&q={{../q}}{{/if}}">Previous</a>{{/if}}
    Page {{pagination.page}} / {{pagination.pages}}
    {{#if pagination.next}}<a href="/?page={{pagination.next}}{{#if ../q}}&q={{../q}}{{/if}}">Next</a>{{/if}}
  </nav>
{{/if}}
