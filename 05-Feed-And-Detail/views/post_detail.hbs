<article>
  <h1>{{post.title}}</h1>
  <p class="text-muted">by {{post.authorName}}</p>
  <div>{{{post.content}}}</div>
  {{#if canEdit}}
    <div class="mt-3 d-flex gap-2">
      <a class="btn btn-sm btn-primary" href="/posts/{{post.id}}/edit">Edit</a>
      <form method="post" action="/posts/{{post.id}}/delete"><button class="btn btn-sm btn-danger" type="submit">Delete</button></form>
    </div>
  {{/if}}
</article>
